{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/client-service-consent", "destination": "/client-service-consent-form", "type": 301 },
  { "source": "/reports", "destination": "/research-reports", "type": 301 },
  { "source": "/admin/static/:path*", "destination": "/static/:path", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }

    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=()" }
        ]
      },
        {
          "source": "**/*",
          "headers": [
            { "key": "Vary", "value": "Accept-Encoding" }
          ]
        },
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
        {
          "source": "**/*.{css,svg,txt}",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "**/*.{webp,avif,png,jpg,jpeg}",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "**/*.{woff2,woff,ttf,otf,eot}",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, stale-while-revalidate=60" }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=60" }
        ]
      },
      {
        "source": "/asset-manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, stale-while-revalidate=60" }
        ]
      },
      {
        "source": "/static/js/*.map",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, stale-while-revalidate=60" }
        ]
      }
    ]
},
"database": {
    "rules": "database.rules.json"
  }
}