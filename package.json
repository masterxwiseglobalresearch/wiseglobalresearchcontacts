  "scripts": {
    "start": "react-scripts start",
    "start:3001": "cross-env PORT=3001 react-scripts start",
    "start:ci": "cross-env PORT=3000 react-scripts start",
    "dev": "concurrently \"npm:start\" \"npm:server\"",
    "server": "npm --prefix server start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:a11y": "react-scripts test --watchAll=false --testPathPattern=a11y.smoke.test.js",
    "pa11y": "pa11y-ci --config pa11y.config.json",
    "pa11y:prod": "pa11y-ci --config pa11y.prod.config.json",
    "eject": "react-scripts eject",
    "analyze": "npx source-map-explorer \"build/static/js/*.js\"",
    "analyze:bundle": "npx webpack-bundle-analyzer build/static/js/main.*.js",
    "lighthouse": "npx lighthouse http://localhost:3000 --output html --output-path ./lighthouse-local.html --chrome-flags=\"--headless\"",
    "images:build": "node scripts/generate-images.js",
    "lint": "eslint \"src/**/*.{js,jsx}\" --fix",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "firebase:deploy": "firebase deploy --only database --project web-wiseglobalresearch",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project web-wiseglobalresearch"
  },
  "overrides": {
    "typescript": "4.9.5"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:3001",
  "devDependencies": {
    "ajv": "^6.12.6",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest-axe": "^7.0.0",
    "lint-staged": "^16.1.2",
    "pa11y-ci": "^3.0.1",
    "postcss": "^8.5.6",
    "serve": "^14.2.3",
    "sharp": "^0.32.0",
    "source-map-explorer": "^2.5.3",
    "webpack-dev-server": "^5.2.2"
  }
}
